# Development only. Replace every placeholder before starting.
DB_USER=postgres
DB_PASSWORD=replace-with-a-random-database-password
DB_URL=jdbc:postgresql://localhost:5432/pool_safety
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AI_SERVICE_KEY=replace-with-a-random-service-key-of-at-least-24-chars
DEV_PASSWORD=replace-with-your-development-password
SPRING_PROFILES_ACTIVE=dev
# false: one ADMIN + one STAFF, no cameras/incidents; true: full demo data
DEV_SAMPLE_DATA=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,file://,null
STAFF_FALSE_ALARM=true
POOL_TIMEZONE=Asia/Ho_Chi_Minh
# Production first start only (do not activate the dev profile in production):
# BOOTSTRAP_ADMIN_PASSWORD=
