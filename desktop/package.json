{
  "name": "pool-safety-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Pool Safety Monitoring control center",
  "author": "Pool Safety",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@pool-safety/shared": "1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.13.0",
    "axios": "^1.13.5",
    "zustand": "^5.0.11",
    "lucide-react": "^0.577.0",
    "hls.js": "^1.6.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1",
    "typescript": "~5.9.3",
    "electron": "44.5.1",
    "electron-builder": "^26.8.1",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.poolsafety.desktop",
    "productName": "PoolSafetyMonitoring",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "electronVersion": "44.5.1"
  }
}
