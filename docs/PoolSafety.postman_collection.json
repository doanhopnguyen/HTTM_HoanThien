{
  "info": {
    "name": "Pool Safety Monitoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "aiServiceKey",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "cameraId",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
              "const s=pm.response.json(); pm.collectionVariables.set(\"accessToken\",s.accessToken); pm.collectionVariables.set(\"refreshToken\",s.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s=pm.response.json(); if(s.accessToken){pm.collectionVariables.set(\"accessToken\",s.accessToken); pm.collectionVariables.set(\"refreshToken\",s.refreshToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "List cameras",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/cameras?page=0&size=20"
      }
    },
    {
      "name": "Create camera",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/cameras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"CAM-POSTMAN\",\n  \"name\": \"Deep water\",\n  \"locationDescription\": \"North side\",\n  \"status\": \"ONLINE\",\n  \"monitoringEnabled\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Camera created\", () => pm.response.to.have.status(201)); pm.collectionVariables.set(\"cameraId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update camera",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/cameras/{{cameraId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Deep water - North\"\n}"
        }
      }
    },
    {
      "name": "Create detection event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-AI-SERVICE-KEY",
            "value": "{{aiServiceKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/detection-events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cameraId\": \"{{cameraId}}\",\n  \"eventType\": \"DROWNING\",\n  \"confidence\": 0.94,\n  \"detectedAt\": \"{{$isoTimestamp}}\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Detection created\", () => pm.response.to.have.status(201)); pm.collectionVariables.set(\"incidentId\",pm.response.json().incidentId);"
            ]
          }
        }
      ]
    },
    {
      "name": "List incidents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents?page=0&size=20"
      }
    },
    {
      "name": "Active incidents (several statuses)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents?status=NEW&status=ACKNOWLEDGED&status=IN_PROGRESS&page=0&size=20"
      }
    },
    {
      "name": "Acknowledge",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/acknowledge"
      }
    },
    {
      "name": "Start handling",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/start"
      }
    },
    {
      "name": "Resolve",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/resolve",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Swimmer rescued safely\"\n}"
        }
      }
    },
    {
      "name": "Admin override: resolve or false alarm an incident handled by someone else (ADMIN token)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/resolve",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Closed from the control room\"\n}"
        }
      }
    },
    {
      "name": "False alarm (use a NEW or ACKNOWLEDGED incident)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/false-alarm",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Confirmed normal swimming activity\"\n}"
        }
      }
    },
    {
      "name": "Incident history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/history?page=0&size=20"
      }
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/notifications?page=0&size=20"
      }
    },
    {
      "name": "Unread count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/notifications/unread-count"
      }
    },
    {
      "name": "Read all",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/notifications/read-all"
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard/summary"
      }
    },
    {
      "name": "Reports",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard/report?days=30"
      }
    },
    {
      "name": "Staff list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/staff"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const u=pm.response.json().content[0]; if(u){pm.collectionVariables.set(\"userId\",u.id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Search users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users?role=STAFF&status=ACTIVE&search=staff"
      }
    },
    {
      "name": "Reset password (ADMIN)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}/password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newPassword\": \"Replace-With-New-Password-123\"\n}"
        }
      }
    },
    {
      "name": "Online cameras",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/cameras/online"
      }
    },
    {
      "name": "Camera statistics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard/camera-statistics?days=30"
      }
    },
    {
      "name": "Audit logs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/audit-logs?action=ADMIN_OVERRIDE&page=0&size=20"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      }
    }
  ]
}
