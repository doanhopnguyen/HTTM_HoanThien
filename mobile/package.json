{
  "name": "pool-safety-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-mobile.ps1",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-mobile.ps1 -Action run:android",
    "ios": "expo run:ios",
    "prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-mobile.ps1 -Action prebuild",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "export": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-mobile.ps1 -Action export --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@pool-safety/shared": "1.0.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.14.5",
    "axios": "^1.13.5",
    "expo": "~58.0.24",
    "expo-font": "~58.0.12",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
