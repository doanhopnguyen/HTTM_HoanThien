{
  "expo": {
    "name": "Pool Safety",
    "slug": "pool-safety-monitoring",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.poolsafety.mobile",
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.poolsafety.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "icon": "./assets/icon.png"
  }
}
